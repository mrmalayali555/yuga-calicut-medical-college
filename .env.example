# Environment variables reference for YUGA College Union Portal
# For local development with SQLite:
POSTGRES_PRISMA_URL="file:./dev.db"
POSTGRES_URL_NON_POOLING="file:./dev.db"
DATABASE_URL="file:./dev.db"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin session JWT secret (replace with a secure random string in production)
JWT_SECRET="replace-with-a-secure-random-secret-for-production"
